{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soc-agent.local/contracts/llm.request.schema.json",
  "title": "LlmProviderRequest",
  "type": "object",
  "required": ["request_id", "operation", "input", "requested_at"],
  "properties": {
    "request_id": { "type": "string" },
    "operation": { "type": "string", "enum": ["generate", "analyze"] },
    "input": {
      "type": "object",
      "description": "Structured prompt/context; external data must be treated as data (R1) by caller/adapter policy",
      "properties": {
        "instructions": { "type": "string" },
        "data": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "expected_schema_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "object" },
    "requested_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": true
}
