{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soc-agent.local/contracts/common.schema.json",
  "title": "Common SOC Agent Contract Types",
  "type": "object",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp with timezone"
    },
    "confidence": {
      "description": "Explicit confidence level for a classification/decision",
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "string", "enum": ["low", "medium", "high", "unknown"] }
      ]
    },
    "classification": {
      "type": "object",
      "required": ["label", "justification"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "severity": { "type": "string" }
      },
      "additionalProperties": true
    },
    "consultedSource": {
      "type": "object",
      "required": ["capability", "reference", "status", "consulted_at"],
      "properties": {
        "source_id": { "type": "string" },
        "capability": {
          "type": "string",
          "enum": ["alert_source", "search_backend", "enrichment", "threat_intel", "policy_engine", "llm_provider", "other"]
        },
        "reference": { "description": "Query, object, scope or identifier consulted", "type": ["string", "object", "array", "number", "boolean", "null"] },
        "status": { "type": "string", "enum": ["ok", "unavailable", "partial", "error", "not_consulted"] },
        "consulted_at": { "$ref": "#/$defs/timestamp" },
        "details": { "type": ["string", "object", "null"] }
      },
      "additionalProperties": true
    },
    "dataSufficiency": {
      "type": "object",
      "required": ["sufficient", "known", "missing", "escalation_required"],
      "properties": {
        "sufficient": { "type": "boolean" },
        "known": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "escalation_required": { "type": "boolean" },
        "escalation_reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hypothesis": {
      "type": "object",
      "required": ["title", "rationale"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "is_false_positive": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "hypotheses": {
      "type": "object",
      "required": ["primary", "alternatives"],
      "properties": {
        "primary": { "$ref": "#/$defs/hypothesis" },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hypothesis" }
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["request_id", "created_at"],
      "properties": {
        "request_id": { "type": "string" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "model_version": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "policy_version": { "type": ["string", "null"] },
        "agent_version": { "type": ["string", "null"] },
        "initiator": { "type": ["string", "object", "null"] }
      },
      "additionalProperties": true
    },
    "timeWindow": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/timestamp" },
        "end": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "costEstimate": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "estimated_scan_units": { "type": ["number", "string", "null"] },
        "estimated_duration": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "additionalProperties": true
    }
  }
}
